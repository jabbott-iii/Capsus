{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(go version)",
      "Bash(go env)",
      "Bash(go env CC)",
      "Bash(go list *)",
      "Bash(go build *)",
      "Bash(go vet *)",
      "Bash(go test *)",
      "Bash(go mod tidy -diff)",
      "Bash(go mod verify)",
      "Bash(gofmt -l *)",
      "Bash(gofmt -s -l *)",
      "Bash(gofmt -d *)",
      "Bash(gofmt -s -d *)",
      "Bash(make build)",
      "Bash(make test)",
      "Bash(make vet)",
      "Bash(make lint)",
      "Bash(make cover)",
      "Bash(make help)",
      "Bash(golangci-lint --version)",
      "Bash(golangci-lint run ./...)",
      "Bash(GOOS=linux golangci-lint run ./...)",
      "Bash(GOOS=darwin golangci-lint run ./...)",
      "Bash(GOOS=windows golangci-lint run ./...)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git ls-files *)",
      "Bash(git grep *)",
      "Bash(bash .claude/skills/docs-sync/docs-drift.sh)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git tag *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(git clean *)",
      "Bash(make tag *)",
      "Bash(go get *)",
      "Bash(go mod tidy)",
      "Bash(go mod edit *)",
      "Bash(gh workflow run *)",
      "Edit(/go.mod)",
      "Edit(/go.sum)",
      "Edit(/.golangci.yml)",
      "Edit(/.github/workflows/**)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(make release *)",
      "Bash(make push-tag *)",
      "Bash(gh release *)",
      "Bash(gh pr merge *)",
      "Read(.env)",
      "Read(.env.*)"
    ]
  }
}
