{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make help)",
      "Bash(make layout)",
      "Bash(make build)",
      "Bash(make smoke)",
      "Bash(make clean)",
      "Bash(make test)",
      "Bash(make race)",
      "Bash(make cover)",
      "Bash(make vet)",
      "Bash(make fmt)",
      "Bash(make fmt-check)",
      "Bash(make lint)",
      "Bash(make tidy-check)",
      "Bash(make keys-check)",
      "Bash(make deps-drift)",
      "Bash(make check)",
      "Bash(make sec)",
      "Bash(make vuln)",
      "Bash(make actionlint)",
      "Bash(make security)",
      "Bash(make check-all)",
      "Bash(make tool *)",
      "Bash(bash scripts/smoke.sh *)",
      "Bash(go version)",
      "Bash(go env *)",
      "Bash(go list *)",
      "Bash(go build *)",
      "Bash(go vet *)",
      "Bash(go test *)",
      "Bash(go mod tidy -diff)",
      "Bash(go mod verify)",
      "Bash(gofmt -l *)",
      "Bash(gofmt -s -l *)",
      "Bash(gofmt -d *)",
      "Bash(gofmt -s -d *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git ls-files *)",
      "Bash(git grep *)",
      "Bash(git describe *)",
      "Bash(git blame *)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git reset *)",
      "Bash(git stash *)",
      "Bash(git clean *)",
      "Bash(git merge *)",
      "Bash(git subtree *)",
      "Bash(go get *)",
      "Bash(go mod tidy)",
      "Bash(go mod edit *)",
      "Bash(go work *)",
      "Bash(make docker-static)",
      "Bash(gh pr create *)",
      "Bash(gh workflow run *)",
      "Edit(/go.mod)",
      "Edit(/go.sum)",
      "Edit(/Makefile)",
      "Edit(/scripts/**)",
      "Edit(/Dockerfile)",
      "Edit(/.dockerignore)",
      "Edit(/.github/**)",
      "Edit(/NOTICE.txt)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/hooks/**)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git tag *)",
      "Bash(git commit --amend *)",
      "Bash(git rebase *)",
      "Bash(git reset --hard *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(git subtree push *)",
      "Bash(make release *)",
      "Bash(make tag *)",
      "Bash(make push-tag *)",
      "Bash(make -C *)",
      "Bash(gh release *)",
      "Bash(gh pr merge *)",
      "Edit(/Munus/**)",
      "Edit(/Cryptare/**)",
      "Edit(/Salus/**)",
      "Edit(/LICENSE)",
      "Edit(/THIRD_PARTY_LICENSES)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(*.db)",
      "Read(*.db-journal)",
      "Read(*.db-wal)",
      "Read(*.db-shm)",
      "Read(*.ckey)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/go-post-edit.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
